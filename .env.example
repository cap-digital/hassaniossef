# URL pública do site (usada em canonical, Open Graph e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# Código de verificação de domínio do Meta Business (Configurações > Segurança da marca > Domínios)
# Gera a tag <meta name="facebook-domain-verification" content="..."> no <head>
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
